{
    "name": "b4react",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:tauri": "node scripts/start-tauri-dev.mjs",
        "generate:api": "node scripts/generate-api.mjs",
        "generate:api:contract": "npm run generate:api",
        "generate:api:optional": "npm run generate:api",
        "api:sync:strict": "npm run generate:api",
        "api:sync": "npm run generate:api:optional",
        "build:web": "tsc && vite build",
        "build": "npm run build:web",
        "build:desktop": "npm run build:web",
        "build:sync": "npm run api:sync && npm run build",
        "build:strict": "npm run api:sync:strict && npm run build",
        "tauri": "node scripts/run-tauri.mjs",
        "tauri:dev": "node scripts/run-tauri.mjs dev",
        "preview": "vite preview",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run src/tests/unit",
        "test:component": "vitest run src/tests/component",
        "test:integration": "vitest run src/tests/integration",
        "test:all": "npm run test:unit && npm run test:component && npm run test:integration && npm run test:e2e",
        "test:e2e": "playwright test",
        "test:e2e:ui": "playwright test --ui",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "api:check": "node scripts/generate-api.mjs --check",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@stripe/react-stripe-js": "^7.0.0",
        "@stripe/stripe-js": "^10.0.0",
        "@tauri-apps/api": "^2.11.1",
        "html-to-image": "1.11.13",
        "i18next": "^25.8.13",
        "lucide-react": "^0.575.0",
        "openapi-fetch": "^0.15.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-i18next": "^16.5.4",
        "react-router-dom": "^7.1.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.56.1",
        "@tauri-apps/cli": "^2.11.4",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.0",
        "@testing-library/user-event": "^14.6.1",
        "@types/react": "^18.3.18",
        "@types/react-dom": "^18.3.5",
        "@vitejs/plugin-react": "^4.3.4",
        "jsdom": "^27.0.1",
        "msw": "^2.11.5",
        "openapi-typescript": "^7.10.1",
        "prettier": "^3.4.2",
        "typescript": "^5.7.2",
        "vite": "^6.0.5",
        "vitest": "^4.1.11"
    }
}
