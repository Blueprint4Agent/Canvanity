# Vite dev-server basePath only. Empty or / keeps root development.
# Production builds are relocatable; the hosting server supplies runtime HTML metadata.
VITE_BASE_PATH=

# -------------------------------
# Frontend API
# -------------------------------
# Optional. Leave empty for same-host local development (frontend :5173 -> API :8000).
# Values: Empty for same-host development, or an absolute HTTP(S) backend base URL.
VITE_API_BASE_URL=

# Public, build-time sharing metadata. Rebuild after changing these values.
# Optional HTTP(S) origin only, e.g. https://your-domain.example (no path/query).
# Empty omits social URL/image tags; never put credentials here.
VITE_PUBLIC_SITE_URL=
# Optional public description; defaults to template copy or the configured project name.
VITE_SITE_DESCRIPTION=

# Optional public support link. Requires server app_mode=development; hidden in production.
# Build-time values: rebuild after changing them. Never put credentials in VITE_*.
VITE_BUY_ME_A_COFFEE_ENABLED=false
# HTTPS creator profile URL, e.g. https://buymeacoffee.com/yourname
VITE_BUY_ME_A_COFFEE_URL=

# Opt-in B4A introduction at /about/ and /about/ko/ (default template identity only).
# Requires VITE_PUBLIC_SITE_URL. App pages become noindex; public pages remain indexable.
VITE_PUBLIC_DISCOVERY=false
# Optional public IndexNow ownership key, 8-128 ASCII letters/digits/hyphens.
VITE_INDEXNOW_KEY=
